# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role (Project Settings -> API -> service_role). SERVER ONLY.
# Bypasses RLS: the cron dispatcher needs it to read every user's logs.
# NEVER prefix this NEXT_PUBLIC_ — that would ship a key that can read and write
# every user's data to every browser, with no visible symptom.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (console.anthropic.com -> API keys) - SERVER ONLY, never exposed to browser
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Web Push. Generate ONCE with:  npx web-push generate-vapid-keys
#
# These are permanent. Rotating VAPID_PRIVATE_KEY breaks every existing subscription
# — push services reject a mismatched key with 403, there is no migration path, and
# every device has to resubscribe. Generate once, keep them in a password manager.
# The public key is baked into the client bundle at build time, so changing it needs
# a redeploy AND a resubscribe from every device.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required by the push spec; some push services reject sends without it.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for /api/cron/dispatch. Any random string, 16+ chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`; the
# pg_cron job in supabase/003_cron.sql sends the same header. Keep the two in sync.
CRON_SECRET=

# Enables ?dry=1 and ?now= on /api/cron/dispatch. LOCAL ONLY — leave unset on Vercel.
# Deliberately its own var rather than a NODE_ENV check: `next start` runs as
# production, and that's the only local mode where push works, so a NODE_ENV gate
# would ignore ?dry=1 exactly where you'd type it and send real notifications instead.
ALLOW_CRON_DEBUG=
